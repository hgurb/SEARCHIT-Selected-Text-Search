# Track only extension runtime files and this exclusion policy.
/*
!/.gitignore
!/manifest.json
!/background.js
!/options.html
!/options.css
!/options.js
!/popup.js
!/popup-label.js
!/popup-position.js
!/popup-settings.js
!/search.js
!/theme.js
!/transfer.js
!/icons/
/icons/*
!/icons/icon16.png
!/icons/icon48.png
!/icons/icon128.png
!/icons/chrome-web-store.png
