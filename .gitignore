# Track extension runtime files, public documentation, and this exclusion policy.
/*
!/.gitignore
!/README.md
!/PRIVACY.md
!/LICENSE
!/manifest.json
!/background.js
!/options.html
!/options.css
!/options.js
!/popup.js
!/popup-label.js
!/popup-position.js
!/popup-settings.js
!/search.js
!/welcome.html
!/welcome.css
!/welcome.js
!/theme.js
!/transfer.js
!/icons/
/icons/*
!/icons/icon16.png
!/icons/icon48.png
!/icons/icon128.png
!/icons/chrome-web-store.png

!/icons/welcome-youtube.png
!/icons/welcome-imdb.png
!/icons/welcome-reddit.png
