{
  "manifest_version": 3,
  "name": "SEARCHIT Selected Text Search",
  "version": "1.2.0",
  "description": "Search selected text on your own editable list of websites.",
  "minimum_chrome_version": "123",
  "permissions": ["contextMenus", "storage", "favicon", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [{ "resources": ["_favicon/*"], "matches": ["http://*/*", "https://*/*"] }],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Manage search options" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
